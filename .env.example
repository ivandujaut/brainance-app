# Copiar a `.env.local` y completar. Nunca commitear valores reales.
# Las variables NEXT_PUBLIC_* se exponen al navegador: no poner secretos ahí.

# --- Base de datos (Postgres) ---
# URL con pooler, usada por la app en runtime
DATABASE_URL=
# URL directa (sin pooler), usada por `prisma migrate`
DIRECT_URL=

# --- Auth (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up

# --- Subida de archivos (Uploadcare) ---
NEXT_PUBLIC_UPLOAD_CARE_PUBLIC_KEY=
UPLOAD_CARE_SECRET_KEY=

# --- IA (ver docs/adr/0001-estrategia-de-modelos-de-ia.md) ---
# Vercel AI Gateway: una sola key para todos los proveedores
AI_GATEWAY_API_KEY=
# Modelo juez del eval (opcional; por defecto anthropic/claude-opus-5.5)
EVAL_JUDGE_MODEL=
# Legacy, se reemplaza por el gateway
OPEN_AI_KEY=

# --- Realtime (Pusher) ---
NEXT_PUBLIC_PUSHER_APP_KEY=
NEXT_PUBLIC_PUSHER_APP_CLUSTOR=
PUSHER_APP_ID=
PUSHER_APP_SECRET=

# --- Email (Nodemailer) ---
NODE_MAILER_EMAIL=
NODE_MAILER_GMAIL_APP_PASSWORD=

# --- Pagos (Stripe) — fuera del alcance de la beta ---
STRIPE_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISH_KEY=

# --- Blog (WordPress en Cloudways) — fuera del alcance de la beta ---
CLOUDWAYS_POST_URL=
CLOUDWAYS_FEATURED_IMAGES_URL=
CLOUDWAYS_UPLOADS_URL=
CLOUDWAYS_AUTHORS_URL=
