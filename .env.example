# Copiar a `.env.local` y completar. Nunca commitear valores reales.
# Las variables NEXT_PUBLIC_* se exponen al navegador: no poner secretos ahí.

# --- Base de datos (Postgres) ---
# URL con pooler, usada por la app en runtime
DATABASE_URL=
# URL directa (sin pooler), usada por `prisma migrate`
DIRECT_URL=
# Base para tests de integración (se vacían tablas de prueba; no usar la de desarrollo)
TEST_DATABASE_URL=

# --- Auth (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up

# --- Íconos del sitio y del bot (Vercel Blob, ver docs/adr/0011-iconos-en-vercel-blob.md) ---
# Vercel la carga sola al conectar el Blob store al proyecto. En local: `vercel env pull`, o dejala vacía (la subida falla con un aviso).
BLOB_READ_WRITE_TOKEN=

# --- IA (ver docs/adr/0001-estrategia-de-modelos-de-ia.md) ---
# Vercel AI Gateway: una sola key para todos los proveedores.
# Solo para local y el eval: en Vercel no hace falta, los deploys se autentican con OIDC (VERCEL_OIDC_TOKEN).
AI_GATEWAY_API_KEY=
# Modelo juez del eval (opcional; por defecto anthropic/claude-opus-5.5)
EVAL_JUDGE_MODEL=
# Modelo que responde en el widget (por defecto anthropic/claude-haiku-4.5)
AI_ANSWER_MODEL=
# Solo E2E: habilita AI_ANSWER_MODEL=mock/echo (respuestas fijas, sin costo)
AI_ALLOW_MOCK_MODEL=

# --- Tiempo real (Pusher, opcional; ADR 0007) ---
# Sin estas cuatro variables, la bandeja y el widget se actualizan por polling.
# La clave pública y el cluster llegan al navegador desde el servidor: no hacen falta variables NEXT_PUBLIC_.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=

# --- Errores y métricas (Sentry y uso de IA, ADR 0008) ---
# Sin DSN, los errores van a la consola. El DSN no es secreto: el navegador usa NEXT_PUBLIC_SENTRY_DSN.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Opcional: sube los source maps en el build (si falta, el build no cambia).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Tope diario de gasto de IA por sitio en USD (por defecto 2): aviso al 80 %, corte al 100 %.
AI_SITE_DAILY_COST_USD=
# Límite por IP del widget (spec 015, ADR 0009): clave del HMAC que guarda la huella de la IP, nunca la IP.
# Al menos 32 bytes aleatorios (`openssl rand -base64 32`). Fuera de producción hay una fija; en producción,
# sin esta variable el chat funciona sin límite por IP y el error va a Sentry.
RATE_LIMIT_SECRET=
# Vercel Cron (vercel.json) la manda como `Authorization: Bearer` para purgar las huellas de cada día.
CRON_SECRET=
# Ids de Clerk (separados por coma) que pueden entrar a /admin.
ADMIN_CLERK_IDS=

# --- Email (Resend, ADR 0006) ---
# EMAIL_PROVIDER: "log" (escribe en la consola; por defecto fuera de producción) o "resend" (por defecto en producción).
EMAIL_PROVIDER=
RESEND_API_KEY=
# Remitente de un dominio verificado en Resend, por ejemplo "BrAInance <avisos@brainance.app>".
EMAIL_FROM=

# --- Textos legales (spec 008) ---
# Contacto y responsable que aparecen en /terminos y /privacidad. Si faltan, las páginas lo marcan.
LEGAL_CONTACT_EMAIL=
LEGAL_ENTITY=
# true cuando un abogado revisó los textos: quita el aviso de borrador.
LEGAL_REVIEWED=

# --- App ---
# URL pública de la app (snippet de instalación y links de los emails al dueño). En Vercel, los previews usan la URL de la rama.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Solo desarrollo/E2E: permite embeber el widget en sitios http:// (en producción se exige https)
WIDGET_ALLOW_HTTP=
