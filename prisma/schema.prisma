// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullname  String
  clerkId   String   @unique
  // Terms and privacy policy accepted at sign-up or later (spec 008).
  termsAcceptedAt DateTime?
  termsVersion    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  domains Domain[]

  subscription Billings?
}

model Domain {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String
  icon String

  chatBot         ChatBot?
  helpdesk        HelpDesk[]
  filterQuestions FilterQuestions[]

  customer   Customer[]
  User       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String?    @db.Uuid

  modelCalls ModelCall[]
}

model ChatBot {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  welcomeMessage String?
  icon           String?
  background     String?
  // What the business does, how to address visitors ("vos" | "usted") and where to refer them.
  description    String?
  addressing     String  @default("vos")
  contact        String?
  // Lead capture (spec 005): show the lead card in the widget, and email the owner on new leads.
  leadCapture    Boolean @default(true)
  leadEmail      Boolean @default(true)
  // Set when the owner confirms the snippet is on their site (later: first widget load).
  installedAt    DateTime?
  Domain         Domain? @relation(fields: [domainId], references: [id], onDelete: Cascade)
  domainId       String? @unique @db.Uuid
}

model Billings {
  id      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  plan    Plans   @default(STANDARD)
  credits Int     @default(10)
  User    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String? @unique @db.Uuid
}

model HelpDesk {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question String
  answer   String

  Domain   Domain? @relation(fields: [domainId], references: [id], onDelete: Cascade)
  domainId String? @db.Uuid
}

model FilterQuestions {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question String

  Domain   Domain? @relation(fields: [domainId], references: [id], onDelete: Cascade)
  domainId String? @db.Uuid
}

model CustomerResponses {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  question   String
  answered   String?
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String   @db.Uuid
}

model Customer {
  id    String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email String?
  // Anonymous widget visitor: random id kept in the visitor's browser (spec 003).
  visitorId String?
  // A visitor becomes a lead when they leave their email (spec 005).
  leadAt    DateTime?
  consentAt DateTime?

  leadSubmissions LeadSubmission[]

  questions CustomerResponses[]

  chatRoom ChatRoom[]

  Domain   Domain? @relation(fields: [domainId], references: [id], onDelete: Cascade)
  domainId String? @db.Uuid

  @@unique([domainId, visitorId])
  @@index([domainId, leadAt])
}

// One row per lead form submission: counts the visitor's rate limit and the site's daily emails (spec 005).
model LeadSubmission {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt  DateTime @default(now())
  notified   Boolean  @default(false)
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String   @db.Uuid

  @@index([customerId, createdAt])
}

model ChatRoom {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  liveSince       DateTime?
  needsAttention  Boolean   @default(false)
  // "derivation" | "human_request" | "site_cap"
  attentionReason String?
  lastMessageAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  Customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String?   @db.Uuid

  message ChatMessage[]

  @@index([lastMessageAt])
}

model ChatMessage {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  message    String
  role       Role?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  ChatRoom   ChatRoom? @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  chatRoomId String?   @db.Uuid
  seen       Boolean   @default(false)

  @@index([chatRoomId, createdAt])
  @@index([chatRoomId, seen])
}

enum Plans {
  STANDARD
  PRO
  ULTIMATE
}

enum Role {
  user
  assistant
  // Spec 006: messages written by the owner from the inbox, and notices shown to the visitor.
  owner
  system
}

// One row per model call (spec 007, ADR 0008): cost, tokens and latency, never conversation text.
model ModelCall {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt        DateTime @default(now())
  domainId         String   @db.Uuid
  chatRoomId       String?  @db.Uuid
  // "answer" for now; classifiers or RAG would add their own purposes.
  purpose          String
  requestedModel   String
  servedModel      String?
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  // Estimated; null when the model has no price in src/domain/model-prices.ts.
  costUsd          Decimal? @db.Decimal(12, 6)
  latencyMs        Int
  finishReason     String?
  error            String?

  Domain Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@index([domainId, createdAt])
  @@index([createdAt])
}

